                ]
              },
              "hotel": {
                "type": "object",
                "properties": {
                  "hotelId": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "rating": {
                    "type": "number",
                    "description": "Star rating, 0 when unknown"
                  },
                  "address": {
                    "type": "object",
                    "properties": {
                      "cityCode": {
                        "type": "string"
                      },
                      "cityName": {
                        "type": "string"
                      },
