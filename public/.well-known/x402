                  },
                  "amenities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Amadeus amenity codes, e.g. WIFI, PARKING, SWIMMING_POOL"
                  }
                }
              },
              "checkInDate": {
                "type": "string",
                "format": "date"
              },
              "checkOutDate": {
                "type": "string",
                "format": "date"
              },
              "nights": {
                "type": "integer"
              },
              "adults": {
                "type": "integer"
              },
              "room": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "beds": {
                    "type": "integer"
                  },
                  "bedType": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              },
              "boardType": {
                "type": "string",
                "description": "ROOM_ONLY | BREAKFAST | HALF_BOARD"
              },
              "price": {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "string"
                  },
                  "perNight": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              },
              "cancellation": {
                "type": "object",
                "properties": {
                  "refundable": {
                    "type": "boolean"
                  },
                  "deadline": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "policy": {
                    "type": "string"
                  }
                }
              },
              "available": {
                "type": "boolean"
              }
            },
            "required": [
              "offerId",
              "hotel",
              "price",
              "cancellation"
            ]
          },
          "priceBreakdown": {
            "type": "object",
            "properties": {
              "nights": {
                "type": "integer"
              },
              "perNight": {
                "type": "string"
              },
              "total": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "priceGuarantee": {
            "type": "string"
          },
          "pricedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "offerId",
          "confirmed",
          "offer",
          "priceBreakdown"
        ]
      }
    }
  ]
}
