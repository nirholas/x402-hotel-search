        {
          "scheme": "exact",
          "network": "solana",
          "asset": "USDC",
          "payTo": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW",
          "maxAmountRequired": "3000",
          "mimeType": "application/json"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "offerId": {
            "type": "string",
            "description": "An offerId from GET /search"
          }
        },
        "required": [
